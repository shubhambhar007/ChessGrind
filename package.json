{
  "name": "chess-puzzles",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run test:data",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "puzzles:generate": "node scripts/generate-original-puzzles.mjs",
    "puzzles:validate": "node scripts/validate-puzzles.mjs",
    "openings:generate": "node scripts/generate-opening-drills.mjs",
    "openings:validate": "node scripts/validate-opening-drills.mjs",
    "moves:validate": "tsx scripts/validate-move-guides.mjs",
    "test:data": "npm run puzzles:validate && npm run openings:validate && npm run moves:validate",
    "test:critical": "playwright test",
    "test:critical:headed": "playwright test --headed"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "chess.js": "^1.4.0",
    "dodopayments": "^2.55.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-chessboard": "^5.12.1",
    "react-dom": "19.2.8",
    "standardwebhooks": "^1.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
